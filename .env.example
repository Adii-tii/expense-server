# Server & Client Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGO_DB_CONNECTION_URL=mongodb://localhost:27017/expense-merge

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email Service Configuration (Nodemailer via Google App Passwords)
GOOGLE_EMAIL=your_email@gmail.com
GOOGLE_APP_PASSWORD=your_google_app_password

# Cloudinary Configuration (Image Uploads)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# Razorpay Payments Integration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_MONTHLY_PLAN_ID=plan_monthly_id
RAZORPAY_YEARLY_PLAN_ID=plan_yearly_id
